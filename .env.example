# ══════════════════════════════════════════════
#  نبض المنصات — Environment Variables Example
#  Copy to .env and fill in real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════

# ── Telegram (optional — fallback to sample data) ──
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── Twitter / X API v2 (optional) ──────────────────
TWITTER_BEARER_TOKEN=

# ── Database path (default: data/platform_pulse.db) ─
DATABASE_PATH=data/platform_pulse.db

# ── Logging level ──────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard port ─────────────────────────────────
DASHBOARD_PORT=8501

# ── Data collection interval (hours) ──────────────
COLLECTION_INTERVAL_HOURS=24
